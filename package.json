{
  "name": "bible-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/stdio.ts",
    "start:http": "node --disable-warning=ExperimentalWarning src/http.ts",
    "check": "tsc",
    "inspect": "npx @modelcontextprotocol/inspector node --disable-warning=ExperimentalWarning src/stdio.ts",
    "data:fetch": "node scripts/fetch-stepbible.ts",
    "data:build": "node --disable-warning=ExperimentalWarning scripts/build-db.ts",
    "fixtures": "node scripts/make-fixtures.ts",
    "test": "node --test \"test/{unit,db,golden,e2e}/**/*.test.ts\"",
    "test:realdb": "node --disable-warning=ExperimentalWarning --test \"test/realdb/**/*.test.ts\"",
    "lint": "oxlint --type-aware --deny-warnings src scripts test",
    "fmt": "oxfmt src scripts test",
    "fmt:check": "oxfmt --check src scripts test",
    "test:mutation": "stryker run",
    "test:mutation:full": "stryker run --force"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/tap-runner": "10.1.1",
    "@types/node": "^24.19.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  }
}
